{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sapu.invalid/schema/v1/analyze.json",
  "title": "data of sapu analyze --json",
  "type": "object",
  "required": ["top", "depth", "root"],
  "additionalProperties": false,
  "properties": {
    "top": { "description": "Children kept per folder.", "type": "integer", "minimum": 1 },
    "depth": { "description": "Levels shown below the root.", "type": "integer", "minimum": 1 },
    "root": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "node": {
      "description": "Bytes and files are recursive totals, even where children are cut off. Children are largest first.",
      "type": "object",
      "required": ["name", "path", "bytes", "files", "is_dir"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 },
        "is_dir": { "type": "boolean" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
